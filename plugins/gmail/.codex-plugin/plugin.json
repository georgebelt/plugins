{
  "name": "gmail",
  "version": "0.2.1",
  "description": "Read Gmail and prepare drafts through a local community MCP server, with separate Google authorization for each mailbox.",
  "author": {
    "name": "georgebelt",
    "url": "https://github.com/georgebelt/plugins"
  },
  "homepage": "https://workspace.google.com/products/gmail/",
  "repository": "https://github.com/georgebelt/plugins",
  "license": "MIT",
  "keywords": [
    "gmail",
    "email",
    "google",
    "google workspace",
    "mail",
    "inbox",
    "threads",
    "drafts"
  ],
  "mcpServers": "./.mcp.json",
  "skills": "./skills/",
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/gmail-setup/SKILL.md"
    }
  },
  "interface": {
    "displayName": "Gmail (Local MCP)",
    "shortDescription": "Read mail and prepare drafts",
    "longDescription": "Community integration using workspace-mcp by Taylor Wilsdon. Runs on your computer with your own Google OAuth client. Supports multiple separately authorized Gmail accounts. Requires uv and Google OAuth setup; does not use the OpenAI Gmail connector.",
    "developerName": "georgebelt · community integration",
    "category": "Communication",
    "capabilities": [
      "Read",
      "Write"
    ],
    "websiteURL": "https://workspace.google.com/products/gmail/",
    "privacyPolicyURL": "https://policies.google.com/privacy",
    "termsOfServiceURL": "https://policies.google.com/terms",
    "defaultPrompt": [
      "Summarize inbox, draft replies, or process email threads"
    ],
    "brandColor": "#EA4335",
    "composerIcon": "./assets/gmail.png",
    "logo": "./assets/gmail.png",
    "screenshots": []
  }
}
